<mujoco model="balancing_robot_v1">

    <option
        gravity="0 0 -9.81"
        timestep="0.001"
    />

    <worldbody>

        <geom
            name="ground"
            type="plane"
            pos="0 0 0"
            size="5 5 0.1"
        />

        <body
            name="base_body"
            pos="0 0 0.12"
            euler="0 0 0"
        >
            <freejoint name="base_freejoint"/>
            <geom
                name="base_geom"
                type="box"
                pos="0 0 0.22"
                size="0.10 0.12 0.22"
                mass="2.0"
                rgba="0 0.75 0 1"
            />

            <body
                name="left_wheel"
                pos="0 0.155 0"
            >
                <joint
                    name="left_wheel_hinge"
                    type="hinge"
                    axis="0 1 0"
                />

                <geom
                    name="left_wheel_geom"
                    type="cylinder"
                    size="0.12 0.025"
                    mass="0.15"
                    euler="90 0 0"
                    rgba="0 0 0 1"
                />
            </body>

            <body
                name="right_wheel"
                pos="0 -0.155 0"
            >
                <joint
                    name="right_wheel_hinge"
                    type="hinge"
                    axis="0 1 0"
                />

                <geom
                    name="right_wheel_geom"
                    type="cylinder"
                    size="0.12 0.025"
                    mass="0.15"
                    euler="90 0 0"
                    rgba="0 0 0 1"
                />
            </body>
            <site
                name="imu_site"
                pos="0 0 0.22"
                size="0.01"
            />
        </body>

    </worldbody>
    <actuator>
        <motor 
            name="left_wheel_motor"
            joint="left_wheel_hinge"
            gear="1"
            ctrlrange="-2 2"
        />
        <motor 
            name="right_wheel_motor"
            joint="right_wheel_hinge"
            gear="1"
            ctrlrange="-2 2"
        />
    </actuator>
    <sensor>
        <gyro
            name="imu_gyro"
            site="imu_site"
        />
        <accelerometer
            name="imu_accel"
            site="imu_site"
        />
        <jointpos
            name="left_wheel_pos"
            joint="left_wheel_hinge"
        />
        <jointvel
            name="left_wheel_vel"
            joint="left_wheel_hinge"
        />
        <jointpos
            name="right_wheel_pos"
            joint="right_wheel_hinge"
        />
        <jointvel
            name="right_wheel_vel"
            joint="right_wheel_hinge"
        />
    </sensor>
</mujoco>